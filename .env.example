# =========================================================================
# Variáveis de ambiente — exemplo
# =========================================================================
# Copie este arquivo para `.env` (na raiz do projeto) e preencha com valores
# reais antes de rodar `docker compose up`. NUNCA versione o `.env`.
#
#   cp .env.example .env
#
# =========================================================================

# -------------------------------------------------------------------------
# PostgreSQL
# -------------------------------------------------------------------------
# Usuário, senha e nome do banco usados pela imagem oficial postgres:15.
# A senha NÃO deve ser "1234" em ambientes que não sejam o seu local.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=valle_leads

# Porta exposta no host (container expõe sempre 5432 internamente).
POSTGRES_PORT=5433

# -------------------------------------------------------------------------
# Backend (Node.js + Prisma)
# -------------------------------------------------------------------------
# String de conexão usada pelo Prisma. Deve apontar para o serviço
# "postgres" do docker-compose (não para localhost).
DATABASE_URL=postgresql://postgres:troque-esta-senha@postgres:5432/valle_leads

# Segredo usado para assinar o JWT. Gere algo aleatório e longo:
#   openssl rand -hex 64
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-longo

# Porta exposta pelo backend.
BACKEND_PORT=3000

# Ambiente de execução (development | production | test).
NODE_ENV=development

# -------------------------------------------------------------------------
# Frontend (Vite)
# -------------------------------------------------------------------------
# Porta exposta no host pelo dev server do Vite.
FRONTEND_PORT=5173
