# =========================================================================
# Backend — variáveis de ambiente (exemplo)
# =========================================================================
# Para desenvolvimento local rodando `npm run dev` (fora do docker), copie
# este arquivo para `backend/.env` e preencha. NUNCA versione o `.env`.
#
#   cp .env.example .env
#
# Quando estiver rodando via `docker compose up`, as variáveis vêm do `.env`
# da raiz do projeto via `env_file` no docker-compose.yml.
# =========================================================================

# String de conexão Prisma → aponte para o Postgres do docker-compose
# usando a porta mapeada no host (5433 por padrão).
DATABASE_URL=postgresql://postgres:troque-esta-senha@localhost:5433/valle_leads

# Segredo usado para assinar o JWT. Gere algo aleatório e longo:
#   openssl rand -hex 64
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-longo

# Porta HTTP do backend.
PORT=3000

# Ambiente de execução (development | production | test).
NODE_ENV=development
